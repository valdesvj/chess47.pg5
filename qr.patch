+/* Append formatted text without writing past the destination buffer. */
+static int qr_appendf(char **out, size_t *remaining, const char *fmt, ...) {
+  if (*remaining == 0) return 0;
+
+  va_list ap;
+  va_start(ap, fmt);
+  int n = vsnprintf(*out, *remaining, fmt, ap);
+  va_end(ap);
+
+  if (n < 0 || (size_t)n >= *remaining) {
+    (*out)[*remaining - 1] = '\0';
+    *remaining = 0;
+    return 0;
+  }
+
+  *out += n;
+  *remaining -= (size_t)n;
+  return 1;
+}
+
+/* Build the QR payload (optional FEN, moves, result) within cap bytes. */
+static int qr_build_text(char *buf, size_t cap) {
+  if (cap == 0) return 0;
+
+  char *out = buf;
+  size_t remaining = cap;
+  *out = '\0';
+
+  if (chess960 || G->hist[0].fullmove != 1) {
+    char fen[100];
+    pos_to_fen(&G->hist[0], fen);
+    if (!qr_appendf(&out, &remaining, "[FEN \"%s\"]\n", fen)) return 0;
+  }
+
+  int col = 0;
+  for (int i = 0; i < G->n; i++) {
+    const Pos *p = &G->hist[i];
+    char tok[20];
+    int n;
+    if (p->side == WHITE)
+      n = snprintf(tok, sizeof tok, "%d. %s", p->fullmove, G->san[i]);
+    else if (i == 0)
+      n = snprintf(tok, sizeof tok, "%d... %s", p->fullmove, G->san[i]);
+    else
+      n = snprintf(tok, sizeof tok, "%s", G->san[i]);
+
+    if (n < 0 || (size_t)n >= sizeof tok) return 0;
+    if (!qr_appendf(&out, &remaining, "%s%s", col ? " " : "", tok)) return 0;
+    col += n + (col ? 1 : 0);
+  }
+
+  return qr_appendf(&out, &remaining, "%s%s\n", col ? " " : "", result_tag());
+}
